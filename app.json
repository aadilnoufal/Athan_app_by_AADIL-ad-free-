{
  "expo": {
    "name": "Prayer Times by AADIL",
    "slug": "prayer-times",
    "version": "4.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "prayertimes",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#141009"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aadilnoufal.prayertimes",
      "buildNumber": "95",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "This app uses location to calculate accurate prayer times for your area.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.yourcompany.prayertimes",
      "versionCode": 90,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "SYSTEM_ALERT_WINDOW",
        "com.android.vending.BILLING"
      ],
      "allowBackup": true,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/azan.wav",
            "./assets/sounds/beep.wav"
          ]
        }
      ],
      ["./plugins/withWidgetExtension", { "appleTeamId": "MNPBRLN354" }]
    ],
    "extra": {
      "eas": {
        "projectId": "f0bad73e-5773-4af0-b9b3-c829ee9495ec",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "PrayerTimesWidget",
                  "bundleIdentifier": "com.aadilnoufal.prayertimes.PrayerTimesWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.aadilnoufal.prayertimes"]
                  }
                }
              ]
            }
          }
        }
      },
      "comment": "Android folder removed - EAS Build handles Android project generation from app.json configuration",
      "revenuecat": {
        "iosApiKey": "appl_HlFMTQjuEPSpeLuaudMrIpsLqsf",
        "androidApiKey": "goog_dfuJwpbmzyvVmySItVuilefFYFM"
      }
    },
    "newArchEnabled": true,
    "owner": "aadiln"
  }
}