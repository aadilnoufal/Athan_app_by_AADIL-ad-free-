<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_4x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Section: All 6 Prayer Times -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <!-- Fajr -->
            <LinearLayout
                android:id="@+id/prayer_item_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <TextView
                    android:id="@+id/prayer_name_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fajr"
                    android:textSize="12sp"
                    android:textColor="@color/midnight_text_secondary"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/prayer_time_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4:57"
                    android:textSize="14sp"
                    android:textColor="@color/midnight_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Sunrise -->
            <LinearLayout
                android:id="@+id/prayer_item_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <TextView
                    android:id="@+id/prayer_name_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sunrise"
                    android:textSize="12sp"
                    android:textColor="@color/midnight_text_secondary"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/prayer_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6:12"
                    android:textSize="14sp"
                    android:textColor="@color/midnight_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Dhuhr -->
            <LinearLayout
                android:id="@+id/prayer_item_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <TextView
                    android:id="@+id/prayer_name_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dhuhr"
                    android:textSize="12sp"
                    android:textColor="@color/midnight_text_secondary"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/prayer_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11:45"
                    android:textSize="14sp"
                    android:textColor="@color/midnight_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Asr -->
            <LinearLayout
                android:id="@+id/prayer_item_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <TextView
                    android:id="@+id/prayer_name_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asr"
                    android:textSize="12sp"
                    android:textColor="@color/midnight_text_secondary"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/prayer_time_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2:48"
                    android:textSize="14sp"
                    android:textColor="@color/midnight_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Maghrib -->
            <LinearLayout
                android:id="@+id/prayer_item_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <TextView
                    android:id="@+id/prayer_name_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maghrib"
                    android:textSize="12sp"
                    android:textColor="@color/midnight_text_secondary"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/prayer_time_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5:30"
                    android:textSize="14sp"
                    android:textColor="@color/midnight_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Isha -->
            <LinearLayout
                android:id="@+id/prayer_item_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <TextView
                    android:id="@+id/prayer_name_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Isha"
                    android:textSize="12sp"
                    android:textColor="@color/midnight_text_secondary"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/prayer_time_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6:52"
                    android:textSize="14sp"
                    android:textColor="@color/midnight_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false" />
            </LinearLayout>

        </LinearLayout>

        <!-- Separator Line -->
        <ImageView
            android:id="@+id/widget_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/midnight_progress_background"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no" />

        <!-- Bottom Section: Mini Progress Ring + Next Prayer + Countdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="2dp">

            <!-- Mini circular progress ring -->
            <ProgressBar
                android:id="@+id/widget_mini_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="75"
                android:progressDrawable="@drawable/circular_progress"
                android:rotation="-90" />

            <!-- Next prayer info (stacked) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/widget_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEXT"
                    android:textColor="@color/midnight_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_next_prayer_name_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maghrib"
                    android:textColor="@color/midnight_accent_gold"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:includeFontPadding="false"
                    android:layout_marginTop="1dp" />

            </LinearLayout>

            <!-- Spacer -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:visibility="invisible" />

            <!-- Countdown Timer -->
            <TextView
                android:id="@+id/widget_countdown_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-01:23"
                android:textColor="@color/midnight_text_primary"
                android:textStyle="bold"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
