<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome notification icon for Prayer Times app.
  Uses a crescent moon silhouette (white on transparent).
  Android notification smallIcon MUST be single-color + alpha only.
  Based on Material Design icon path (Apache 2.0 license).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <!-- scaleX=-1 with pivotX=12 mirrors the crescent horizontally -->
  <group
      android:scaleX="-1"
      android:pivotX="12"
      android:pivotY="12">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9.5,2c-1.82,0 -3.53,0.5 -5,1.35c2.99,1.73 5,4.95 5,8.65s-2.01,6.92 -5,8.65C5.97,21.5 7.68,22 9.5,22c5.52,0 10,-4.48 10,-10S15.02,2 9.5,2z"/>
  </group>
</vector>
