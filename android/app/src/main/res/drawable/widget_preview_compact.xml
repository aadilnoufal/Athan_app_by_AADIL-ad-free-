<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview image for the compact (circular) widget in widget picker.
     Used on pre-Android 12 devices where previewLayout is not supported. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark rounded background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0F1419"
                android:endColor="#131A20"
                android:angle="135" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#1E2A33" />
        </shape>
    </item>
    <!-- Circular progress track (background ring) -->
    <item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp">
        <shape
            android:innerRadiusRatio="2.8"
            android:shape="ring"
            android:thicknessRatio="16.0"
            android:useLevel="false">
            <solid android:color="#1A2530" />
        </shape>
    </item>
    <!-- Circular progress arc (gold sweep, ~75%) -->
    <item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp">
        <rotate
            android:fromDegrees="270"
            android:toDegrees="270"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape
                android:innerRadiusRatio="2.8"
                android:shape="ring"
                android:thicknessRatio="16.0"
                android:useLevel="false">
                <gradient
                    android:startColor="#F0D661"
                    android:endColor="#D4B84A"
                    android:type="sweep" />
            </shape>
        </rotate>
    </item>
</layer-list>
